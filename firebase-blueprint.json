{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "photoURL": { "type": "string" },
        "pointsBalance": { "type": "number" },
        "role": { "type": "string", "enum": ["user", "store", "admin"] },
        "agreedToDisclaimer": { "type": "boolean" }
      },
      "required": ["userId", "name"]
    },
    "Product": {
      "title": "Product",
      "description": "Store product.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "available": { "type": "boolean" },
        "ownerId": { "type": "string" },
        "externalLink": { "type": "string" },
        "averageRating": { "type": "number" },
        "ratingCount": { "type": "number" }
      },
      "required": ["title", "price", "category"]
    },
    "ProductReview": {
      "title": "Product Review",
      "description": "Rating and comment for a specific product.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "rating", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" }
      },
      "required": ["name", "slug"]
    },
    "Message": {
      "title": "Message",
      "description": "Real-time chat message.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "senderId": { "type": "string" },
        "recipientId": { "type": "string" },
        "conversationId": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "recipientId", "conversationId", "participants", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Metadata for a chat thread.",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "unreadCount": { "type": "object" }
      },
      "required": ["participants", "lastMessageAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered"] },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "total", "status"]
   },
    "StoreProfile": {
      "title": "Store Profile",
      "description": "Information about a specific store.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "logoUrl": { "type": "string" },
        "verified": { "type": "boolean" },
        "verifiedUntil": { "type": "string" },
        "whatsapp": { "type": "string" },
        "tiktok": { "type": "string" },
        "instagram": { "type": "string" },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" },
        "ratingCount": { "type": "number" },
        "averageRating": { "type": "number" },
        "averageCredibility": { "type": "number" }
      }
    },
    "Rating": {
      "title": "Rating",
      "description": "Store rating and feedback.",
      "type": "object",
      "properties": {
        "storeId": { "type": "string" },
        "userId": { "type": "string" },
        "rating": { "type": "number" },
        "credibility": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["storeId", "userId", "rating", "credibility", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System notification for users.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["system", "verification_expiry", "order"] },
        "read": { "type": "boolean" },
        "actionUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "createdAt"]
    },
    "GlobalStats": {
      "title": "Global Stats",
      "description": "Metrics for the entire application.",
      "type": "object",
      "properties": {
        "totalVisitors": { "type": "number" },
        "totalRegistered": { "type": "number" },
        "onlineCount": { "type": "number" }
      }
    },
    "Settings": {
      "title": "Settings",
      "description": "Global application settings.",
      "type": "object",
      "properties": {
        "aiPrompt": { "type": "string" },
        "storeName": { "type": "string" },
        "storeLogo": { "type": "string" },
        "storeTheme": { "type": "string" },
        "storeFont": { "type": "string" },
        "heroBanner": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "heroButtonText": { "type": "string" },
        "heroLink": { "type": "string" },
        "showHeroBanner": { "type": "boolean" },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" },
        "seoKeywords": { "type": "string" },
        "cleanupMonths": { "type": "number" },
        "autoCleanupEnabled": { "type": "boolean" }
      }
    },
    "Deployment": {
      "title": "Deployment",
      "description": "System deployment version log.",
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "deployedBy": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["version", "status", "createdAt"]
    },
    "ServerLog": {
      "title": "Server Log",
      "description": "Logs generated by the server background tasks.",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "error", "success"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["message", "type", "timestamp"]
    },
    "StoreWallet": {
      "title": "Store Wallet",
      "description": "Merchant and store electronic wallets and payment configurations.",
      "type": "object",
      "properties": {
        "wallets": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["wallets"]
    }
  },
  "firestore": {
    "settings/{settingId}": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "Global application settings."
    },
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles."
    },
    "products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products available in the store."
    },
    "orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders."
    },
    "conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Chat conversations."
    },
    "messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Individual chat messages."
    },
    "storeProfiles/{userId}": {
      "schema": { "$ref": "#/entities/StoreProfile" },
      "description": "Store profiles."
    },
    "storeWallets/{storeId}": {
      "schema": { "$ref": "#/entities/StoreWallet" },
      "description": "Merchant electronic wallets and accounts."
    },
    "ratings/{ratingId}": {
      "schema": { "$ref": "#/entities/Rating" },
      "description": "Store ratings."
    },
    "productReviews/{reviewId}": {
      "schema": { "$ref": "#/entities/ProductReview" },
      "description": "Individual product reviews."
    },
    "notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "System notifications."
    },
    "stats/{statId}": {
      "schema": { "$ref": "#/entities/GlobalStats" },
      "description": "Global application stats."
    },
    "deployments/{deploymentId}": {
      "schema": { "$ref": "#/entities/Deployment" },
      "description": "Deployment logs."
    },
    "serverLogs/{logId}": {
      "schema": { "$ref": "#/entities/ServerLog" },
      "description": "Server activity logs."
    }
  }
}
