{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "photoURL": { "type": "string" },
        "pointsBalance": { "type": "number" },
        "role": { "type": "string", "enum": ["user", "store", "admin"] },
        "agreedToDisclaimer": { "type": "boolean" }
      },
      "required": ["userId", "name"]
    },
    "Product": {
      "title": "Product",
      "description": "Store product.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "available": { "type": "boolean" },
        "stock": { "type": ["number", "null"] },
        "status": {
          "type": "string",
          "enum": ["queued", "pending_review", "active", "rejected", "draft"]
        },
        "moderationStatus": {
          "type": ["string", "null"],
          "enum": ["queued", "pending_review", "approved", "rejected", null]
        },
        "rejectionReason": { "type": ["string", "null"] },
        "queuedAt": { "type": ["string", "null"] },
        "submittedForReviewAt": { "type": ["string", "null"] },
        "reviewedAt": { "type": ["string", "null"] },
        "reviewedBy": { "type": ["string", "null"] },
        "ownerId": { "type": "string" },
        "ownerName": { "type": ["string", "null"] },
        "externalLink": { "type": "string" },
        "averageRating": { "type": "number" },
        "ratingCount": { "type": "number" },
        "hasOffer": { "type": "boolean" },
        "offerType": { "type": "string", "enum": ["discount", "bonus", "bundle", "free_delivery"] },
        "originalPrice": { "type": "number" },
        "discountPercent": { "type": "number" },
        "offerTitle": { "type": "string" },
        "offerExtras": { "type": "string" },
        "offerExpiresAt": { "type": "string" },
        "noDelivery": { "type": "boolean" },
        "isPreOrderEnabled": { "type": "boolean" },
        "depositAmount": { "type": ["number", "null"] },
        "reservationDurationDays": { "type": ["number", "null"] },
        "reservationTerms": { "type": ["string", "null"] },
        "variants": {
          "type": "array",
          "description": "Individual product variants added exclusively by the publishing store."
        },
        "adminOptions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Filter/badge option IDs assigned exclusively by admin."
        }
      },
      "required": ["title", "price", "category"]
    },
    "ProductReview": {
      "title": "Product Review",
      "description": "Rating and comment for a specific product.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "rating", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" }
      },
      "required": ["name", "slug"]
    },
    "StoreCategory": {
      "title": "Store Category",
      "description": "Admin-managed directory category for stores (e.g., pharmacies, malls, shops, mechanic workshops).",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "icon": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["name", "slug"]
    },
    "BannerAd": {
      "title": "Banner Ad",
      "description": "Admin-managed hero advertising banner slot (up to 5 slots, linked to a store or promo).",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": ["string", "null"] },
        "badgeText": { "type": ["string", "null"] },
        "image": { "type": "string" },
        "buttonText": { "type": ["string", "null"] },
        "targetStoreId": { "type": ["string", "null"] },
        "targetStoreName": { "type": ["string", "null"] },
        "customLink": { "type": ["string", "null"] },
        "order": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["image", "order", "active"]
    },
    "Message": {
      "title": "Message",
      "description": "Real-time chat message.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "senderId": { "type": "string" },
        "recipientId": { "type": "string" },
        "conversationId": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "recipientId", "conversationId", "participants", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Metadata for a chat thread.",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "unreadCount": { "type": "object" }
      },
      "required": ["participants", "lastMessageAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "proposedDeliveryFee": { "type": ["number", "null"] },
        "deliveryFeeApprovalStatus": {
          "type": "string",
          "enum": ["pending_customer", "accepted", "rejected", "expired"]
        },
        "deliveryFeeAcceptMinutes": { "type": ["number", "null"] },
        "deliveryFeeProposedAt": { "type": ["string", "null"] },
        "deliveryFeeExpiresAt": { "type": ["string", "null"] },
        "deliveryFeeRespondedAt": { "type": ["string", "null"] },
        "deliveryFeeExpiredAt": { "type": ["string", "null"] },
        "courierId": { "type": ["string", "null"] },
        "courierName": { "type": ["string", "null"] },
        "courierPhone": { "type": ["string", "null"] },
        "deliveryStatus": { "type": ["string", "null"] },
        "noDelivery": { "type": ["boolean", "null"] },
        "fulfillmentType": { "type": ["string", "null"], "enum": ["delivery", "store_pickup", null] },
        "isPreOrder": { "type": ["boolean", "null"] },
        "depositAmount": { "type": ["number", "null"] },
        "remainingAmount": { "type": ["number", "null"] },
        "reservationDurationDays": { "type": ["number", "null"] },
        "reservationExpiresAt": { "type": ["string", "null"] },
        "reservationStatus": { "type": ["string", "null"] },
        "reservationTerms": { "type": ["string", "null"] },
        "depositForfeited": { "type": ["boolean", "null"] },
        "depositForfeitedAt": { "type": ["string", "null"] },
        "storeAddress": { "type": ["string", "null"] },
        "storePhone": { "type": ["string", "null"] },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "processing",
            "shipped",
            "delivered",
            "cancelled",
            "reserved",
            "deposit_paid",
            "reservation_expired",
            "out_for_delivery"
          ]
        },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "total", "status"]
    },
    "StoreProfile": {
      "title": "Store Profile",
      "description": "Information about a specific store.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "logoUrl": { "type": "string" },
        "verified": { "type": "boolean" },
        "verifiedUntil": { "type": "string" },
        "whatsapp": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "district": { "type": "string" },
        "address": { "type": "string" },
        "landmark": { "type": "string" },
        "workingHours": { "type": "string" },
        "googleMapsUrl": { "type": "string" },
        "location": { "type": ["object", "null"] },
        "coordinates": { "type": ["object", "null"] },
        "tiktok": { "type": "string" },
        "instagram": { "type": "string" },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" },
        "ratingCount": { "type": "number" },
        "averageRating": { "type": "number" },
        "averageCredibility": { "type": "number" },
        "statsReset": { "type": ["object", "null"] },
        "storeCategoryIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Admin-assigned store category IDs."
        }
      }
    },
    "Rating": {
      "title": "Rating",
      "description": "Store rating and feedback.",
      "type": "object",
      "properties": {
        "storeId": { "type": "string" },
        "userId": { "type": "string" },
        "rating": { "type": "number" },
        "credibility": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["storeId", "userId", "rating", "credibility", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System notification for users.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["system", "verification_expiry", "order"] },
        "read": { "type": "boolean" },
        "actionUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "createdAt"]
    },
    "GlobalStats": {
      "title": "Global Stats",
      "description": "Metrics for the entire application.",
      "type": "object",
      "properties": {
        "totalVisitors": { "type": "number" },
        "totalRegistered": { "type": "number" },
        "onlineCount": { "type": "number" },
        "dailyVisits": { "type": "object" },
        "statsReset": { "type": ["object", "null"] }
      }
    },
    "Settings": {
      "title": "Settings",
      "description": "Global application settings.",
      "type": "object",
      "properties": {
        "aiPrompt": { "type": "string" },
        "storeName": { "type": "string" },
        "storeLogo": { "type": "string" },
        "storeTheme": { "type": "string" },
        "storeFont": { "type": "string" },
        "heroBanner": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "heroButtonText": { "type": "string" },
        "heroLink": { "type": "string" },
        "showHeroBanner": { "type": "boolean" },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" },
        "seoKeywords": { "type": "string" },
        "cleanupMonths": { "type": "number" },
        "autoCleanupEnabled": { "type": "boolean" },
        "discoveryConfig": { "type": ["object", "null"] }
      }
    },
    "Deployment": {
      "title": "Deployment",
      "description": "System deployment version log.",
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "deployedBy": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["version", "status", "createdAt"]
    },
    "ServerLog": {
      "title": "Server Log",
      "description": "Logs generated by the server background tasks.",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "error", "success"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["message", "type", "timestamp"]
    },
    "StoreWallet": {
      "title": "Store Wallet",
      "description": "Merchant and store electronic wallets and payment configurations.",
      "type": "object",
      "properties": {
        "wallets": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["wallets"]
    }
  },
  "firestore": {
    "settings/{settingId}": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "Global application settings."
    },
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles."
    },
    "products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products available in the store."
    },
    "orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders."
    },
    "conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Chat conversations."
    },
    "messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Individual chat messages."
    },
    "storeProfiles/{userId}": {
      "schema": { "$ref": "#/entities/StoreProfile" },
      "description": "Store profiles."
    },
    "storeCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/StoreCategory" },
      "description": "Admin-managed store directory categories."
    },
    "bannerAds/{adId}": {
      "schema": { "$ref": "#/entities/BannerAd" },
      "description": "Admin-managed hero advertising banner spaces (up to 5)."
    },
    "storeWallets/{storeId}": {
      "schema": { "$ref": "#/entities/StoreWallet" },
      "description": "Merchant electronic wallets and accounts."
    },
    "ratings/{ratingId}": {
      "schema": { "$ref": "#/entities/Rating" },
      "description": "Store ratings."
    },
    "productReviews/{reviewId}": {
      "schema": { "$ref": "#/entities/ProductReview" },
      "description": "Individual product reviews."
    },
    "notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "System notifications."
    },
    "stats/{statId}": {
      "schema": { "$ref": "#/entities/GlobalStats" },
      "description": "Global application stats."
    },
    "deployments/{deploymentId}": {
      "schema": { "$ref": "#/entities/Deployment" },
      "description": "Deployment logs."
    },
    "serverLogs/{logId}": {
      "schema": { "$ref": "#/entities/ServerLog" },
      "description": "Server activity logs."
    }
  }
}
