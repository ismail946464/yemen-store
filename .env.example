# ==========================================
# اليمن ستور (Yemen Store) - Environment Variables
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted (e.g., https://yemen-store-online.vercel.app).
APP_URL="https://yemen-store-online.vercel.app"

# ==========================================
# Firebase Configuration (Vercel Production)
# ==========================================
# FIREBASE_SERVICE_ACCOUNT_JSON: The full JSON string or base64-encoded string of your Firebase Service Account.
# In Vercel Project Settings -> Environment Variables, add this for full backend admin privileges.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Alternative individual credentials:
FIREBASE_PROJECT_ID="gen-lang-client-0028962952"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Firestore Database Name
FIRESTORE_DATABASE_ID="ai-studio-3645fbbf-8fe8-4b8a-9113-047a44e34c52"

# Session Secret for signed JWT/HMAC tokens
SESSION_SECRET=""

# ==========================================
# Official SMTP Email Service (Nodemailer)
# ==========================================
# Default sender is "اليمن" <yemenstore@gmail.com>
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="yemenstore@gmail.com"
# SMTP_PASS: Google App Password (16 characters) generated from Google Account Security
SMTP_PASS=""
OTP_SENDER_EMAIL="yemenstore@gmail.com"
OTP_SENDER_NAME="اليمن"
